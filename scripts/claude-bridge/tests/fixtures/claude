#!/usr/bin/env zsh
set -euo pipefail

state_dir="${FAKE_CLAUDE_STATE_DIR:?FAKE_CLAUDE_STATE_DIR is required}"
scenario="${FAKE_CLAUDE_SCENARIO:-success}"
mkdir -p "$state_dir"

print -r -- "$$" >"$state_dir/agent_pid"
print -r -- "$*" >>"$state_dir/args"

success() {
  local result="$1"
  print -r -- "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"$result\",\"session_id\":\"claude-session\",\"request_id\":\"claude-request\"}"
}

case "$scenario" in
  success)
    success "CLAUDE_FAKE_OK"
    ;;
  slow_success)
    sleep "${FAKE_CLAUDE_DELAY_SECONDS:-2}"
    success "SLOW_CLAUDE_FAKE_OK"
    ;;
  stream_slow_success)
    print -r -- '{"type":"system","subtype":"init","session_id":"claude-session"}'
    print -r -- '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"private Claude text that must not reach the observer"}},"session_id":"claude-session"}'
    sleep "${FAKE_CLAUDE_DELAY_SECONDS:-2}"
    print -r -- '{"type":"stream_event","event":{"type":"message_stop"},"session_id":"claude-session"}'
    success "STREAM_CLAUDE_FAKE_OK"
    ;;
  empty)
    success ""
    ;;
  *)
    print -u2 -- "unknown fake scenario: $scenario"
    exit 64
    ;;
esac
