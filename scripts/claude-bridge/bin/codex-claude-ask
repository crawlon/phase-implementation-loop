#!/usr/bin/env zsh
set -euo pipefail

wrapper_name="codex-claude-ask"

if ! command -v claude >/dev/null 2>&1; then
  print -u2 -- "claude CLI was not found on PATH"
  exit 127
fi

if ! command -v jq >/dev/null 2>&1; then
  print -u2 -- "jq is required to validate Claude's structured result"
  exit 127
fi

claude_args=(
  --print
  --verbose
  --output-format stream-json
  --include-partial-messages
  --permission-mode plan
  --no-chrome
  --no-session-persistence
)

user_args=()
prompt_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prompt-file)
      if [[ $# -lt 2 ]]; then
        print -u2 -- "usage: $wrapper_name [claude options] [--prompt-file path] '<prompt>'"
        exit 64
      fi
      prompt_file="$2"
      shift 2
      ;;
    --prompt-file=*)
      prompt_file="${1#--prompt-file=}"
      shift
      ;;
    *)
      user_args+=("$1")
      shift
      ;;
  esac
done

stdin_prompt=""
if [[ ! -t 0 ]]; then
  stdin_prompt="$(cat || true)"
fi

if [[ -n "$prompt_file" ]]; then
  if [[ ! -r "$prompt_file" ]]; then
    print -u2 -- "prompt file is not readable: $prompt_file"
    exit 66
  fi
  user_args+=("$(<"$prompt_file")")
elif [[ -n "$stdin_prompt" ]]; then
  user_args+=("$stdin_prompt")
fi

if [[ ${#user_args[@]} -eq 0 ]]; then
  print -u2 -- "usage: $wrapper_name [claude options] [--prompt-file path] '<prompt>'"
  exit 64
fi

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/codex-claude-wrapper.XXXXXX")"
stdout_file="$temp_dir/stdout"
stderr_file="$temp_dir/stderr"
claude_pid=""
run_timed_out=0
stream_lines_seen=0
stream_events_since_heartbeat=0
stream_last_type="none"
stream_last_subtype="none"
stream_idle_seconds=0

emit_event() {
  local state="$1"
  shift

  local event="CODEX_CLAUDE_EVENT state=$state $*"
  print -u2 -- "$event"
  if [[ -n "${CODEX_CLAUDE_STATUS_FILE:-}" ]]; then
    print -r -- "$event" >>"$CODEX_CLAUDE_STATUS_FILE" 2>/dev/null || true
  fi
}

stop_claude() {
  if [[ -n "$claude_pid" ]] && kill -0 "$claude_pid" 2>/dev/null; then
    kill -TERM "$claude_pid" 2>/dev/null || true
    sleep 1
    if kill -0 "$claude_pid" 2>/dev/null; then
      kill -KILL "$claude_pid" 2>/dev/null || true
    fi
    wait "$claude_pid" 2>/dev/null || true
  fi
  claude_pid=""
}

on_signal() {
  emit_event "cancelled" "signal=$1"
  stop_claude
  exit 143
}

cleanup() {
  local original_status=$?
  stop_claude
  rm -rf -- "$temp_dir"
  return "$original_status"
}

trap cleanup EXIT
trap 'on_signal HUP' HUP
trap 'on_signal INT' INT
trap 'on_signal TERM' TERM

observe_stream_events() {
  local line_count start_line event_type event_subtype
  line_count="$(wc -l <"$stdout_file")"
  line_count="${line_count//[[:space:]]/}"
  if (( line_count <= stream_lines_seen )); then
    return
  fi

  start_line=$((stream_lines_seen + 1))
  while IFS=$'\t' read -r event_type event_subtype; do
    [[ -z "$event_type" ]] && continue
    stream_events_since_heartbeat=$((stream_events_since_heartbeat + 1))
    stream_last_type="$event_type"
    stream_last_subtype="${event_subtype:-none}"
  done < <(
    sed -n "${start_line},${line_count}p" "$stdout_file" |
      jq -r 'select(type == "object") | [(.type // "unknown"), (.subtype // .event.type // "none")] | @tsv' 2>/dev/null
  )
  stream_lines_seen=$line_count
}

emit_liveness() {
  local heartbeat_seconds="$1"

  observe_stream_events
  if (( stream_events_since_heartbeat > 0 )); then
    emit_event "activity" "events=$stream_events_since_heartbeat last_type=$stream_last_type last_subtype=$stream_last_subtype idle_seconds=0"
    stream_events_since_heartbeat=0
    stream_idle_seconds=0
    return
  fi

  stream_idle_seconds=$((stream_idle_seconds + heartbeat_seconds))
  emit_event "heartbeat" "idle_seconds=$stream_idle_seconds last_type=$stream_last_type last_subtype=$stream_last_subtype"
}

run_claude() {
  local heartbeat_seconds="${CODEX_CLAUDE_HEARTBEAT_SECONDS:-15}"
  local max_seconds="${CODEX_CLAUDE_MAX_SECONDS:-}"
  local elapsed_seconds=0
  run_timed_out=0
  stream_lines_seen=0
  stream_events_since_heartbeat=0
  stream_last_type="none"
  stream_last_subtype="none"
  stream_idle_seconds=0

  if [[ "$heartbeat_seconds" != <-> || "$heartbeat_seconds" -lt 1 ]]; then
    print -u2 -- "$wrapper_name: CODEX_CLAUDE_HEARTBEAT_SECONDS must be a positive integer"
    run_status=64
    return
  fi
  if [[ -n "$max_seconds" && ( "$max_seconds" != <-> || "$max_seconds" -lt 1 ) ]]; then
    print -u2 -- "$wrapper_name: CODEX_CLAUDE_MAX_SECONDS must be a positive integer"
    run_status=64
    return
  fi

  set +e
  claude "${claude_args[@]}" "${user_args[@]}" >"$stdout_file" 2>"$stderr_file" &
  claude_pid=$!
  emit_event "started" "pid=$claude_pid max_seconds=${max_seconds:-none}"

  while kill -0 "$claude_pid" 2>/dev/null; do
    sleep 1
    elapsed_seconds=$((elapsed_seconds + 1))
    if (( elapsed_seconds % heartbeat_seconds == 0 )); then
      emit_liveness "$heartbeat_seconds"
    fi
    if [[ -n "$max_seconds" ]] && (( elapsed_seconds >= max_seconds )); then
      run_timed_out=1
      emit_event "timed_out" "elapsed_seconds=$elapsed_seconds max_seconds=$max_seconds"
      stop_claude
      run_status=124
      set -e
      return
    fi
  done

  wait "$claude_pid"
  run_status=$?
  claude_pid=""
  set -e
}

terminal_result() {
  jq -ce -s '[.[] | select(type == "object" and .type == "result")] | last // empty' "$stdout_file"
}

read_json_field() {
  local field="$1"
  terminal_result | jq -r "$field // \"unknown\"" 2>/dev/null || print -r -- "unknown"
}

result_is_successful() {
  [[ "$run_status" -eq 0 ]] || return 1
  terminal_result | jq -e '.subtype == "success" and .is_error == false' >/dev/null 2>&1
}

result_has_text() {
  terminal_result | jq -e '(.result // "") | type == "string" and test("\\S")' >/dev/null 2>&1
}

failure_reason() {
  if [[ "$run_timed_out" -eq 1 ]]; then
    print -r -- "Claude exceeded configured maximum duration"
  elif [[ "$run_status" -ne 0 ]]; then
    print -r -- "Claude exited with status $run_status"
  elif ! terminal_result >/dev/null 2>&1; then
    print -r -- "Claude returned no terminal stream result"
  elif ! result_is_successful; then
    print -r -- "Claude returned a non-success terminal result"
  else
    print -r -- "Claude returned an empty result"
  fi
}

print_failure() {
  local reason="$1"
  local session_id request_id stdout_bytes stderr_bytes
  session_id="$(read_json_field '.session_id')"
  request_id="$(read_json_field '.request_id')"
  stdout_bytes="$(wc -c <"$stdout_file")"
  stdout_bytes="${stdout_bytes//[[:space:]]/}"
  stderr_bytes="$(wc -c <"$stderr_file")"
  stderr_bytes="${stderr_bytes//[[:space:]]/}"

  if [[ -s "$stderr_file" ]]; then
    command cat "$stderr_file" >&2
  fi
  print -u2 -- "$wrapper_name: $reason (status=$run_status stdout_bytes=$stdout_bytes stderr_bytes=$stderr_bytes session_id=$session_id request_id=$request_id)"
}

run_claude
if result_is_successful && result_has_text; then
  emit_event "succeeded" "status=0"
  terminal_result | jq -r '.result'
  exit 0
fi

reason="$(failure_reason)"
print_failure "$reason"
emit_event "failed" "status=$run_status timed_out=$run_timed_out"
if [[ "$run_status" -ne 0 ]]; then
  exit "$run_status"
fi
exit 70
